{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|exec_command|shell|shell_command|mcp__.*__(create_pull_request|update_pull_request|merge_pull_request)",
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/pr-workflow.mjs\" post-tool-use --host=codex", "commandWindows": "node \"%PLUGIN_ROOT%/scripts/pr-workflow.mjs\" post-tool-use --host=codex", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/pr-workflow.mjs\" user-prompt-submit --host=codex", "commandWindows": "node \"%PLUGIN_ROOT%/scripts/pr-workflow.mjs\" user-prompt-submit --host=codex", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/pr-workflow.mjs\" stop --host=codex", "commandWindows": "node \"%PLUGIN_ROOT%/scripts/pr-workflow.mjs\" stop --host=codex", "timeout": 10 }
        ]
      }
    ]
  }
}
